# SMTP Server Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASSWORD=your_secret_smtp_password_here
SMTP_FROM=noreply@your-domain.com
SMTP_USE_TLS=true

# Operational Flags
# Set to 'true' or '1' to simulate sending without real network connections
EMAIL_TEST_MODE=true

# Rate Limiting & Safety
MAX_HOURLY_EMAILS=100
MAX_RETRIES=3
COOLDOWN_MINUTES=60
